[Unit]
Description=Herdr headless server (persistent workspaces, agents, and terminals)
After=default.target

[Service]
Type=simple
# herdr is nix-managed (was the mise path). %h expands in Environment=.
Environment=HERDR_BIN_PATH=%h/.nix-profile/bin/herdr
# systemd user services get a minimal PATH; add the nix profile so the server
# and the nvim/pi panes it spawns resolve (mise shims kept for per-project).
Environment=PATH=%h/.nix-profile/bin:%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
# GUI session env: systemd user services get a minimal environment by default.
# Without these, panes lack WAYLAND_DISPLAY/DISPLAY and Neovim's clipboard
# providers (wl-copy/xsel) report "No provider" -- yy yanks silently no-op.
# Adjust values if you switch session types (e.g. X11-only: drop WAYLAND_DISPLAY).
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DISPLAY=:0
Environment=XDG_SESSION_TYPE=wayland
ExecStart=%h/dotfiles/herdr/server.sh
ExecStartPost=%h/dotfiles/herdr/restore.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
