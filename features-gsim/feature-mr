#!/usr/bin/env bash
# Create PRs to main for every worktree in a feature.
#   - title/description come from BRIEF.md (line 1 = title, rest = body)
#   - skips worktrees with uncommitted changes or an existing PR
#   - assigned to the authenticated GitHub user (you)
#   - never merges; PRs land in your review queue
#
# Usage: feature-mr <name> [--dry-run]
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=feature-lib.sh
. "$SCRIPT_DIR/feature-lib.sh"

NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: feature-mr <name> [--dry-run]" >&2; exit 1; }
DRY=0
[ "${2:-}" = "--dry-run" ] && DRY=1
BRANCH="$(feature_branch "$NAME")"

ROOT="$(feature_root "$NAME")"
[ -d "$ROOT" ] || { echo "feature '$NAME' not found: $ROOT" >&2; exit 1; }

TITLE="$(sed -n '1p' "$ROOT/BRIEF.md")"
[ -n "$TITLE" ] || { echo "BRIEF.md first line (PR title) is empty in $ROOT" >&2; exit 1; }
DESC="$(sed '1,1d' "$ROOT/BRIEF.md")"

# Assign every PR to the authenticated GitHub user (your credentials).
ASSIGNEE="$(gh api user --jq .login 2>/dev/null || true)"
[ -n "$ASSIGNEE" ] || echo "WARN: could not resolve GitHub assignee — PRs created without assignee" >&2

declare -a RESULTS
shopt -s nullglob
for wt in "$ROOT"/*/; do
  [ -e "$wt/.git" ] || continue
  repo="$(basename "$wt")"
  branch="$(git -C "$wt" branch --show-current 2>/dev/null)"
  if [ "$branch" != "$BRANCH" ]; then
    echo "skip $repo: on '$branch', not $BRANCH" >&2
    continue
  fi
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    echo "SKIP $repo: uncommitted changes (commit first)" >&2
    RESULTS+=("$repo | SKIPPED: uncommitted changes")
    continue
  fi
  gh_repo="$(gh_repo_of "$wt")"
  target="main"

  if [ "$DRY" = 1 ]; then
    echo "[dry-run] $repo: git push -u origin $BRANCH; gh pr create --repo $gh_repo --base $target --head $BRANCH --title '$TITLE'"
    RESULTS+=("$repo | DRY-RUN")
    continue
  fi

  # existing PR? (gh pr view exits non-zero when none match)
  if gh pr view "$BRANCH" --repo "$gh_repo" --json number >/dev/null 2>&1; then
    echo "SKIP $repo: PR already exists for $BRANCH" >&2
    RESULTS+=("$repo | PR already exists")
    continue
  fi

  echo "== $repo"
  git -C "$wt" push -u origin "$BRANCH" 2>&1 | sed 's/^/  push: /'
  pr_flags=(--repo "$gh_repo" --base "$target" --head "$BRANCH" \
    --title "$TITLE" --body "$DESC")
  [ -n "$ASSIGNEE" ] && pr_flags+=(--assignee "$ASSIGNEE")
  out="$(gh pr create "${pr_flags[@]}" 2>&1)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    url="$(printf '%s\n' "$out" | tail -1)"
    echo "  PR: $url"
    RESULTS+=("$repo | $url")
  else
    echo "  FAILED: $out" >&2
    RESULTS+=("$repo | FAILED: $(printf '%s' "$out" | tail -1)")
  fi
done

echo
echo "=== summary ==="
for r in "${RESULTS[@]}"; do echo "  $r"; done
