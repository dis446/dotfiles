alias i="sudo dnf install"
alias r="sudo dnf remove"
# One-shot update of everything on this machine:
#   1. Nix / Home Manager — tools, runtimes, config, pi binary (scripts/nix-update.sh:
#      git pull, nix flake update, flake check, home-manager switch, npm pi @latest, push flake.lock)
#   2. Nobara system packages via nobara-sync (the Nobara-recommended updater)
#   3. flatpak apps
#   4. pi plugins/extensions
# Stops at the first failure (|| return); fix and re-run `up`.
# unalias first: re-sourcing in a shell that still has the old `up` alias makes
# bash expand it at parse time and choke on `up() {`.
unalias up 2>/dev/null || true
up() {
  printf '\n=== Nix / Home Manager ===\n'
  "$HOME/dotfiles/scripts/nix-update.sh" || return
  printf '\n=== Nobara system (nobara-sync) ===\n'
  nobara-sync cli || return
  printf '\n=== flatpak ===\n'
  flatpak update -y || return
  printf '\n=== pi plugins ===\n'
  pi update --extensions || return
  printf '\nAll updates complete.\n'
}
alias is="dnf search"
alias il="dnf list"

export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/podman/podman.sock"
export DOCKER_SOCK="$XDG_RUNTIME_DIR/podman/podman.sock"
