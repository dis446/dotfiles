#!/usr/bin/env bash
# Re-open an EXISTING feature's herdr workspace (nvim tab per repo, pi
# feature-lead tab, term tab) — the "respawn" half of feature-start, for when
# a feature's workspace was closed (e.g. after a folder migration) but its
# worktrees already exist. Does NOT create or repair worktrees.
#
# Usage: feature-respawn <name> [--prompt '<text>'] [--no-focus]
#   The pi feature-lead is spawned with the repo-local feature-master skill and
#   the given prompt (default: a generic resume prompt). Worktrees are
#   discovered recursively (both $ROOT/<repo>/ and $ROOT/worktrees/<repo>/).
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=feature-lib.sh
. "$SCRIPT_DIR/feature-lib.sh"

NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: feature-respawn <name> [--prompt '<text>'] [--no-focus]" >&2; exit 2; }
shift

PROMPT=""; FOCUS=1
while [ $# -gt 0 ]; do
  case "$1" in
    --no-focus) FOCUS=0 ;;
    --prompt) PROMPT="$2"; shift ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

ROOT="$(feature_root "$NAME")"
[ -d "$ROOT" ] || { echo "feature '$NAME' not found: $ROOT" >&2; exit 1; }

# Discover worktrees recursively, excluding the shared knowledge symlinks.
declare -a WT_DIRS=()
while IFS= read -r -d '' g; do
  WT_DIRS+=("$(dirname "$g")")
done < <(find "$ROOT" -mindepth 2 -name .git \
          -not -path '*/docs/*' -not -path '*/plans/*' -not -path '*/.agents/*' -print0 2>/dev/null)

if [ -z "$PROMPT" ]; then
  PROMPT="You are resuming alpha feature '$NAME'. Its herdr workspace was re-created after a folder migration, so your prior conversation history is gone; re-orient from the files. Read the feature-master skill, then read BRIEF.md, the plan under plans/$NAME/, and each worktree's git log and status. Then continue the feature: run the review and verify phase per repo, push any unpushed work, and run feature-mr when ready. Report what you find and what remains."
fi

# Always create a fresh workspace (feature-start convention: label = feature
# name). A duplicate label may collide with a main-repo workspace of the same
# name; the workspace_id stays unique and feature-stop disambiguates by cwd.
WS_CWD="${WT_DIRS[0]:-$ROOT}"
WSJSON="$(json workspace create --cwd "$WS_CWD" --label "$NAME" --no-focus 2>/dev/null)"
WSID="$(printf '%s' "$WSJSON" | python3 -c "
import json, sys
try: d = json.load(sys.stdin)
except Exception: raise SystemExit
r = d.get('result', {})
w = r.get('workspace', r)
print(w.get('workspace_id', w.get('id', '')) or '')
")"
[ -n "$WSID" ] || { echo "ERROR: herdr workspace create failed (server down?)" >&2; exit 1; }

# 1. main tab: nvim in the first worktree (or the feature root)
mp="$(main_pane_of_ws "$WSID")"
if [ -n "$mp" ] && wait_prompt "$mp" 8; then
  json pane run "$mp" "nvim ." >/dev/null 2>&1
fi
# 2. additional worktree tabs
for d in "${WT_DIRS[@]:1}"; do
  created="$(json tab create --workspace "$WSID" --label "$(basename "$d")" --cwd "$d" --no-focus 2>/dev/null)"
  rp="$(root_pane_of "$created")"
  [ -n "$rp" ] && wait_prompt "$rp" 8 && json pane run "$rp" "nvim ." >/dev/null 2>&1
done
# 3. pi tab: feature-lead agent (repo-local feature-master skill)
created="$(json tab create --workspace "$WSID" --label pi --cwd "$ROOT" --no-focus 2>/dev/null)"
rp="$(root_pane_of "$created")"
if [ -n "$rp" ]; then
  sdir="$(pi_session_dir "$ROOT")"
  wait_prompt "$rp" 8
  skill="$E2E_MAIN/.agents/skills/feature-master"
  skill_flag=""
  [ -d "$skill" ] && skill_flag=" --skill '$skill'"
  json pane run "$rp" "pi -c --session-dir '$sdir'$skill_flag \"$PROMPT\"" >/dev/null 2>&1
  echo "  feature-lead pi started (feature-master skill, $sdir)"
fi
# 4. term tab
json tab create --workspace "$WSID" --label term --cwd "$ROOT" --no-focus >/dev/null 2>&1
if [ "$FOCUS" = 1 ]; then json workspace focus "$WSID" >/dev/null 2>&1; fi
echo "herdr workspace: $WSID (label '$NAME') — $((${#WT_DIRS[@]})) worktree tab(s) + pi + term"
