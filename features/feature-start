#!/usr/bin/env bash
# Start a new alpha feature:
#   - creates ~/Code/and/alpha/features/<name>/ (or $FEATURES_ROOT)
#   - one git worktree per touched repo, branch feat/<name-lowercased> off origin/dev
#   - scaffolds BRIEF.md (first line = MR title)
#   - opens a herdr workspace: nvim tab per repo, pi feature-lead tab, term tab
#
# Modes:
#   CREATE (root missing): full setup. With no repos (or --root-only) the root
#     is created without worktrees — the feature-lead pi session is spawned so
#     the user can prompt it with requirements and let it discover repos.
#   ADD (root exists): adds missing worktrees for the given repos only (used by
#     the feature-lead as it discovers which repos a feature touches). The
#     feature-lead keeps BRIEF.md's "Touched repos" list current itself.
#
# Usage: feature-start <name> [repo ...] [--root-only] [--no-focus]
#   Name is required and must be unique (feature root must not exist for CREATE).
#   Repos accept basenames (state-machine), alpha-relative paths
#   (back-end/state-machine), or absolute paths.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=feature-lib.sh
. "$SCRIPT_DIR/feature-lib.sh"

NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: feature-start <name> [repo ...] [--root-only] [--no-focus]" >&2; exit 2; }
shift
feature_name_valid "$NAME" || { echo "invalid feature name '$NAME' (use [A-Za-z0-9][A-Za-z0-9-]*)" >&2; exit 2; }

# Standardized branch name: feat/<name-lowercased> (see feature_branch in lib)
BRANCH="$(feature_branch "$NAME")"

FOCUS=1; ROOT_ONLY=0
REPOS=()
for a in "$@"; do
  [ "$a" = "--no-focus" ] && { FOCUS=0; continue; }
  [ "$a" = "--root-only" ] && { ROOT_ONLY=1; continue; }
  REPOS+=("$a")
done

ROOT="$(feature_root "$NAME")"

# ---- ADD mode: root exists -> add missing worktrees only ----------------
if [ -e "$ROOT" ]; then
  [ ${#REPOS[@]} -gt 0 ] || { echo "feature '$NAME' already exists: $ROOT" >&2; exit 1; }
  echo "feature '$NAME' exists — adding worktrees for: ${REPOS[*]}"
  for r in "${REPOS[@]}"; do
    d="$(resolve_repo_dir "$r")" || { echo "cannot resolve repo: $r" >&2; continue; }
    wt="$ROOT/$(basename "$d")"
    echo "== $(basename "$d")"
    if [ -e "$wt/.git" ]; then
      echo "  (worktree already exists: $wt)"
    elif git -C "$d" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$d" worktree add "$wt" "$BRANCH" || { echo "  worktree add failed: $d" >&2; continue; }
      echo "  worktree (existing branch): $wt"
    elif git -C "$d" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
      git -C "$d" worktree add --track -b "$BRANCH" "$wt" "origin/$BRANCH" || { echo "  worktree add failed: $d" >&2; continue; }
      echo "  worktree (tracking origin): $wt"
    else
      base="$(base_branch "$d")" || { echo "  cannot determine base branch for $d" >&2; continue; }
      git -C "$d" fetch -q origin dev 2>/dev/null || true
      git -C "$d" worktree add -b "$BRANCH" "$wt" "$base" || { echo "  worktree add failed: $d" >&2; continue; }
      echo "  worktree (new branch $BRANCH off $base): $wt"
    fi
  done
  # backfill shared knowledge dirs for existing feature roots too
  link_knowledge_dirs "$ROOT"
  [ -d "$E2E_MAIN" ] && mkdir -p "$E2E_MAIN/plans/$NAME"
  exit 0
fi

# ---- CREATE mode --------------------------------------------------------
# resolve repos: --root-only forces none; otherwise default to the current repo
# when inside one and no repos were given
if [ "$ROOT_ONLY" = 1 ]; then
  REPOS=()
elif [ ${#REPOS[@]} -eq 0 ] && git rev-parse --show-toplevel >/dev/null 2>&1; then
  REPOS=("$(git rev-parse --show-toplevel)")
fi
mkdir -p "$ROOT" || exit 1
declare -a DIRS=()
for r in "${REPOS[@]}"; do
  d="$(resolve_repo_dir "$r")" || { echo "cannot resolve repo: $r" >&2; rmdir "$ROOT" 2>/dev/null; exit 1; }
  DIRS+=("$d")
done

# BRIEF.md scaffold: line 1 = MR title, rest = description
{
  printf 'feat(%s): <one-line summary>\n\n## What\n\n<describe the feature. the first line above becomes the MR title.>\n\n## Touched repos\n\n' "$NAME"
  if [ ${#DIRS[@]} -gt 0 ]; then
    for d in "${DIRS[@]}"; do printf -- '- %s\n' "$(basename "$d")"; done
  else
    printf '%s\n' '- (none yet — feature master discovers repos from the requirements)'
  fi
} > "$ROOT/BRIEF.md"

# shared knowledge dirs: symlink plans/, docs/, .agents/ from the master repo,
# and give this feature its dedicated plan folder (plans/<name>)
link_knowledge_dirs "$ROOT"
[ -d "$E2E_MAIN" ] && mkdir -p "$E2E_MAIN/plans/$NAME"

# worktrees
for d in "${DIRS[@]}"; do
  base="$(base_branch "$d")" || { echo "cannot determine base branch for $d" >&2; exit 1; }
  wt="$ROOT/$(basename "$d")"
  echo "== $(basename "$d")"
  if git -C "$d" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$d" worktree add "$wt" "$BRANCH" || { echo "  worktree add failed: $d" >&2; exit 1; }
    echo "  worktree (existing branch): $wt"
  elif git -C "$d" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git -C "$d" worktree add --track -b "$BRANCH" "$wt" "origin/$BRANCH" || { echo "  worktree add failed: $d" >&2; exit 1; }
    echo "  worktree (tracking origin): $wt"
  else
    git -C "$d" fetch -q origin dev 2>/dev/null || true
    git -C "$d" worktree add -b "$BRANCH" "$wt" "$base" || { echo "  worktree add failed: $d" >&2; exit 1; }
    echo "  worktree (new branch $BRANCH off $base): $wt"
  fi
done

# herdr workspace: main tab = first worktree (or feature root), pi, term
WS_CWD="${DIRS[0]:-$ROOT}"
WSJSON="$(json workspace create --cwd "$WS_CWD" --label "$NAME" --no-focus 2>/dev/null)"
WSID="$(printf '%s' "$WSJSON" | python3 -c "
import json, sys
try: d = json.load(sys.stdin)
except Exception: raise SystemExit
r = d.get('result', {})
w = r.get('workspace', r)
print(w.get('workspace_id', w.get('id', '')) or '')
")"

if [ -n "$WSID" ]; then
  # 1. main tab: nvim in the first worktree (or the feature root)
  mp="$(main_pane_of_ws "$WSID")"
  if [ -n "$mp" ] && wait_prompt "$mp" 8; then
    json pane run "$mp" "nvim ." >/dev/null 2>&1
  fi
  # 2. additional worktree tabs, nvim in each
  for d in "${DIRS[@]:1}"; do
    created="$(json tab create --workspace "$WSID" --label "$(basename "$d")" --cwd "$d" --no-focus 2>/dev/null)"
    rp="$(root_pane_of "$created")"
    [ -n "$rp" ] && wait_prompt "$rp" 8 && json pane run "$rp" "nvim ." >/dev/null 2>&1
  done
  # 3. pi tab: feature-lead agent (feature-master skill), cwd = feature root
  created="$(json tab create --workspace "$WSID" --label pi --cwd "$ROOT" --no-focus 2>/dev/null)"
  rp="$(root_pane_of "$created")"
  if [ -n "$rp" ]; then
    sdir="$(pi_session_dir "$ROOT")"
    wait_prompt "$rp" 8
    skill="$HOME/.pi/agent/skills/feature-master"
    skill_flag=""
    [ -d "$skill" ] && skill_flag=" --skill '$skill'"
    prompt="Stand by — feature '$NAME' is ready. Do NOT use tools, read files, or explore anything yet (no repo discovery, no feature-list, no reading AGENTS.md). The user will give you the feature requirements next. When they do, read the feature-master skill and begin. For now, reply with a one-line ready confirmation only."
    json pane run "$rp" "pi -c --session-dir '$sdir'$skill_flag \"$prompt\"" >/dev/null 2>&1
    echo "  feature-lead pi started (feature-master skill, $sdir)"
  fi
  # 4. term tab
  json tab create --workspace "$WSID" --label term --cwd "$ROOT" --no-focus >/dev/null 2>&1
  if [ "$FOCUS" = 1 ]; then json workspace focus "$WSID" >/dev/null 2>&1; fi
  echo "herdr workspace: $WSID (label '$NAME')"
else
  echo "WARN: herdr workspace create failed (server down?). Worktrees are ready regardless." >&2
fi

echo
if [ ${#DIRS[@]} -gt 0 ]; then
  echo "feature '$NAME' ready:"
  echo "  root:    $ROOT"
  echo "  brief:   $ROOT/BRIEF.md  (edit line 1 = MR title)"
  echo "  plans:   $ROOT/plans/$NAME  (shared -> $E2E_MAIN/plans/$NAME)"
  echo "  worktrees:"
  for d in "${DIRS[@]}"; do echo "    $ROOT/$(basename "$d")  (branch $BRANCH)"; done
  echo "next: prompt the feature-lead pi in the feature workspace, or run: feature-mr $NAME"
else
  echo "feature '$NAME' created (no worktrees yet):"
  echo "  root:    $ROOT"
  echo "  brief:   $ROOT/BRIEF.md"
  echo "next: go to the feature workspace and prompt the feature-lead pi with the feature requirements;"
  echo "      it will discover the repos and create worktrees (feature_start tool / git worktree add)."
fi
