for alias_file in "$HOME/dotfiles/bash/"*; do
  [ -f "$alias_file" ] && . "$alias_file"
done

[ -f "$HOME/dotfiles/macos/bash_aliases" ] && . "$HOME/dotfiles/macos/bash_aliases"

PS1='\u@\h \W\$ '
command -v mise >/dev/null 2>&1 && eval "$(mise activate bash)"

# ~/.local/bin (pi, gitlab-tui), ~/go/bin (go install), ~/.cargo/bin.
export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$PATH"

# Runtime memory ceilings — same reasoning as fedora/bashrc.
export JAVA_TOOL_OPTIONS="-Xmx2g"
export NODE_OPTIONS="--max-old-space-size=2048"
