**/secret**

pi/agent/auth.json
pi/agent/sessions
pi/agent/settings.json
pi/agent/sessions.json
pi/agent/mcp-cache.json
pi/agent/mcp-npx-cache.json
pi/agent/bin
pi/agent/cache


/pi/context-mode/sessions
/pi/context-mode/content
/pi/agent/trust.json
/pi/agent/skills/**/*.env*

# Claude Code (~/.claude) — track config only, ignore runtime + secrets.
# Whitelist approach: ignore everything, then re-include the config we manage.
claude/*
!claude/settings.json
!claude/keybindings.json
!claude/CLAUDE.md
!claude/hooks/
!claude/commands/
!claude/agents/
!claude/skills/
# plugins/ holds only machine-specific runtime state (cache, clones, install paths).
# Reproducibility comes from settings.json: extraKnownMarketplaces + enabledPlugins
# auto-install everything on startup. So plugins/ stays fully ignored.

# Herdr (~/.config/herdr) — track config only, ignore runtime.
# Only herdr/config.toml is symlinked; the rest of ~/.config/herdr stays local
# (session.json, sockets, logs, plugin lock are machine-local runtime state).
herdr/*.log
herdr/*.sock
herdr/session.json
herdr/.plugins.lock
herdr/agent-detection/

# IntelliJ — track config only, ignore machine-local state.
# Unlike claude/ and pi/, the whole IntelliJ config dir CANNOT be symlinked
# (version-specific path, machine state mixed with config). Settings Sync
# handles cross-machine sync for keymaps/codestyles/options. The dotfiles
# repo tracks only .ideavimrc (symlinked to ~/.ideavimrc) and reference
# copies of keymaps for version history.
intellij/*
!intellij/ideavimrc
!intellij/keymaps/
!intellij/MIGRATION-ADVISORY.md
/pi/pi-acp/session-map.json
/pi/agent/settings.json
/pi/agent/models-store.json
/pi/agent/run-history.jsonl
pi/agent/missions/

pi/agent/.skill-lock.json

# CLI-managed agent skills: installed via npx skills, not versioned here.
# Only the skills explicitly re-included below are tracked.
pi/agent/skills/*
!pi/agent/skills/caveman/
!pi/agent/skills/cve-research/
!pi/agent/skills/create-agentsmd/
!pi/agent/skills/design-doc-mermaid/
!pi/agent/skills/find-skills/
!pi/agent/skills/gitlab-glab/
!pi/agent/skills/herdr/
!pi/agent/skills/lombok-patterns/
!pi/agent/skills/unslop/
claude/skills/*
!claude/skills/find-skills
