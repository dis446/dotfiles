# EditorConfig – global defaults.
# Mirrors Spotless/Eclipse Java formatter settings where EditorConfig supports them.
# See: intellij/.editorconfig-java-format.xml for the full Eclipse formatter config
#      (brace positions, spacing, blank lines – not expressible in EditorConfig).
#
# Spotless / Eclipse formatter reference:
#   /home/neddy/Code/and/alpha/back-end/common/quarkus-common/quarkus-build-config/src/main/resources/eclipse-format.xml

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 2
max_line_length = 128

[*.xml]
indent_size = 2
max_line_length = 128

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.sql]
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
